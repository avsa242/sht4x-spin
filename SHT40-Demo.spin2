{
----------------------------------------------------------------------------------------------------
    Filename:       SHT40-Demo.spin2
    Description:    SHT40 driver demo
        * Temp/RH data output
    Author:         Jesse Burt
    Started:        Oct 27, 2023
    Updated:        May 14, 2025
    Copyright (c) 2025 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------
}

    _clkfreq    = 180_000_000
    _xtlfreq    = 20_000_000


OBJ

    sensor: "sensor.temp_rh.sht40" | SCL=0, SDA=1, I2C_FREQ=1_000_000
    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000


PUB main() | temp, rh, tscl

    setup()

    sensor.temp_scale(sensor.C)                 ' C, F

    repeat
        ser.pos_xy(0, 3)
        temp := sensor.temperature()
        rh := sensor.rh()
        tscl := lookupz(sensor.temp_scale(): "C", "F", "K")
        ser.printf(@"Temp. (deg %c): %3.3d.%02.2d\n\r", tscl, (temp / 100), abs(temp // 100))
        ser.printf(@"Rel. humidity (%%): %3.3d.%02.2d\n\r", (rh / 100), (rh // 100))


PUB setup()

    ser.start()

    ser.clear()
    ser.strln(@"Serial terminal started")

    if ( sensor.start() )
        ser.strln(@"SHT40 driver started")
    else
        ser.strln(@"SHT40 driver failed to start - halting")
        repeat


DAT
